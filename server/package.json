{
  "name": "analyst-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir test/unit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:llm": "vitest run --dir test/llm",
    "test:cleanup": "tsx test/integration/cleanup.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@duckdb/node-api": "1.5.6-r.2",
    "@supabase/supabase-js": "2.118.0",
    "compression": "1.8.2",
    "cors": "2.8.6",
    "csv-parse": "7.0.3",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-rate-limit": "8.7.2",
    "helmet": "8.3.0",
    "multer": "2.5.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "saxes": "6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "exceljs": "4.4.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
