# Copy to server/.env and fill in. Never commit the real .env.
PORT=4000
NODE_ENV=development
APP_NAME=Analyst
CLIENT_URL=http://localhost:5173

# Supabase (Project Settings > API). The service-role key bypasses RLS: server only, never in the client.
SUPABASE_URL=https://yioglyejoiwujzygqyqt.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET_DATASETS=datasets
STORAGE_BUCKET_BRANDING=branding

# LLM provider: openrouter or anthropic. Only the chosen provider's key is required.
LLM_PROVIDER=
# OpenRouter (openrouter.ai/keys). Used when LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=
# Anthropic (console.anthropic.com). Used when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Model ids for the chosen provider: Anthropic ids (claude-...) or OpenRouter ids (anthropic/claude-...).
# The fast model must support a forced tool call (see docs/CONTRACT_CHANGES.md, 2026-11-09).
ANTHROPIC_MODEL_PLANNER=
ANTHROPIC_MODEL_FAST=

# Hard ceiling for any upload; plans set lower limits in plan_limits.
MAX_UPLOAD_MB=50

# Protects POST /api/v1/internal/purge-expired (header x-cron-secret). Any long random string.
CRON_SECRET=

# Slice S6 only (PayFast). Use sandbox values until you go live.
PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_NOTIFY_URL=
PAYFAST_RETURN_URL=
PAYFAST_CANCEL_URL=
