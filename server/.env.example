# Copy to server/.env and fill in. Never commit the real .env.
PORT=4000
NODE_ENV=development
APP_NAME=Analyst
CLIENT_URL=http://localhost:5173

# Supabase (Project Settings > API). The service-role key bypasses RLS: server only, never in the client.
SUPABASE_URL=https://yioglyejoiwujzygqyqt.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET_DATASETS=datasets
STORAGE_BUCKET_BRANDING=branding

# Anthropic (console.anthropic.com). Check the model ids on the models page before use.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_PLANNER=
ANTHROPIC_MODEL_FAST=

# Hard ceiling for any upload; plans set lower limits in plan_limits.
MAX_UPLOAD_MB=50

# Protects POST /api/v1/internal/purge-expired (header x-cron-secret). Any long random string.
CRON_SECRET=

# Slice S6 only (PayFast). Use sandbox values until you go live.
PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_NOTIFY_URL=
PAYFAST_RETURN_URL=
PAYFAST_CANCEL_URL=
